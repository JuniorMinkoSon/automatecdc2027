# Copier en .env et remplir. Le .env ne part jamais dans Git.
# Generer chaque secret avec :  openssl rand -base64 36

# ---------------------------------------------------------------- domaine
DOMAINE=offres.exemple.ci
EMAIL_ACME=exploitation@exemple.ci

# ---------------------------------------------------------------- base de donnees
POSTGRES_DB=automatecdc
POSTGRES_SUPERUSER=postgres
MDP_SUPERUSER=
MDP_MIGRATION=
MDP_APP=
MDP_LECTURE=

# ---------------------------------------------------------------- secrets applicatifs
# Signe les liens de telechargement a duree courte.
CLE_LIENS_SIGNES=
# Chiffre les fichiers au repos. IRREMPLACABLE : si cette cle est perdue,
# aucun DAO, aucune piece et aucun PDF archive ne peut plus etre relu.
# La sauvegarder ailleurs que sur le VPS, et ne jamais la regenerer.
CLE_CHIFFREMENT_FICHIERS=
# Verifie la signature des confirmations de paiement de l'agregateur.
PAIEMENT_SECRET_SIGNATURE=

# ---------------------------------------------------------------- extraction du DAO
# Cle Anthropic. L'IA ne recoit que le texte du DAO ou de la piece a analyser,
# jamais de CNI ni de donnees nominatives du personnel.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- courrier
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
