<?xml version="1.0" encoding="UTF-8"?>
<!--
  Lettre de soumission de l'offre, une par lot.

  Tout ce qui apparait ici vient de la base : le montant en chiffres et le
  montant en lettres sortent du meme nombre, par la meme fonction Java. C'est
  ce qui rend impossible l'ecart que la COJO sanctionne, et c'est pour cela
  qu'aucun des deux n'est un champ de saisie.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="lettre_soumission"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <parameter name="ENTREPRISE_RAISON_SOCIALE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_SIGLE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_RCCM" class="java.lang.String"/>
    <parameter name="ENTREPRISE_CC" class="java.lang.String"/>
    <parameter name="ENTREPRISE_ADRESSE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_BP" class="java.lang.String"/>
    <parameter name="ENTREPRISE_TELEPHONES" class="java.lang.String"/>

    <parameter name="AO_NUMERO" class="java.lang.String"/>
    <parameter name="AO_INTITULE" class="java.lang.String"/>
    <parameter name="AO_DESTINATAIRE" class="java.lang.String"/>
    <parameter name="AO_AUTORITE" class="java.lang.String"/>

    <parameter name="LOT_LIBELLE" class="java.lang.String"/>
    <parameter name="MONTANT_CHIFFRES" class="java.lang.String"/>
    <parameter name="MONTANT_LETTRES" class="java.lang.String"/>
    <parameter name="DELAI_MOIS" class="java.lang.Integer"/>
    <parameter name="VALIDITE_JOURS" class="java.lang.Integer"/>
    <parameter name="TIMBRE_FISCAL" class="java.lang.String"/>

    <parameter name="LIEU" class="java.lang.String"/>
    <parameter name="DATE_LETTRES" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_NOM" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_FONCTION" class="java.lang.String"/>

    <title>
        <band height="110">
            <staticText>
                <reportElement x="0" y="0" width="515" height="16"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[RÉPUBLIQUE DE CÔTE D'IVOIRE]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="16" width="515" height="12"/>
                <textElement textAlignment="Center">
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Union - Discipline - Travail]]></text>
            </staticText>

            <line>
                <reportElement x="180" y="34" width="155" height="1"/>
            </line>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="48" width="515" height="18"/>
                <textElement textAlignment="Center">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["LETTRE DE SOUMISSION DE L'OFFRE"]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="72" width="515" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{LOT_LIBELLE}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="88" width="515" height="14"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{AO_NUMERO} == null || $P{AO_NUMERO}.isBlank()
                    ? "" : "Appel d'offres n° " + $P{AO_NUMERO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="10"/>
    </pageHeader>

    <detail>
        <band height="520">

            <!-- Destinataire -->
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="0" width="235" height="40"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["À : " + ($P{AO_DESTINATAIRE} == null
                    || $P{AO_DESTINATAIRE}.isBlank() ? $P{AO_AUTORITE} : $P{AO_DESTINATAIRE})]]></textFieldExpression>
            </textField>

            <!-- Objet -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="52" width="515" height="34"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Objet : " + $P{AO_INTITULE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="96" width="515" height="16"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Madame, Monsieur,]]></text>
            </staticText>

            <!-- Corps : engagement -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="120" width="515" height="56"/>
                <textElement textAlignment="Justified"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Après avoir examiné le dossier d'appel d'offres et pris pleine "
                    + "connaissance de ses prescriptions, nous, soussignés, agissant au nom et pour le compte de "
                    + $P{ENTREPRISE_RAISON_SOCIALE}
                    + ($P{ENTREPRISE_SIGLE} == null || $P{ENTREPRISE_SIGLE}.isBlank() ? "" : " (" + $P{ENTREPRISE_SIGLE} + ")")
                    + ", nous engageons à exécuter les travaux objet du présent marché."]]></textFieldExpression>
            </textField>

            <!-- Montant, en chiffres puis en lettres -->
            <staticText>
                <reportElement x="0" y="186" width="515" height="14"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Montant de l'offre]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="204" width="515" height="16"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["En chiffres : " + $P{MONTANT_CHIFFRES}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="222" width="515" height="34"/>
                <textElement textAlignment="Justified"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["En lettres : " + $P{MONTANT_LETTRES}]]></textFieldExpression>
            </textField>

            <!-- Engagements de duree -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="268" width="515" height="18"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{DELAI_MOIS} == null ? ""
                    : "Nous nous engageons à exécuter les travaux dans un délai de "
                      + $P{DELAI_MOIS} + " mois à compter de l'ordre de service."]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="288" width="515" height="30"/>
                <textElement textAlignment="Justified"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{VALIDITE_JOURS} == null ? ""
                    : "La présente offre demeure valable et nous engage pour une durée de "
                      + $P{VALIDITE_JOURS} + " jours à compter de la date limite de dépôt des offres."]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="0" y="324" width="515" height="30"/>
                <textElement textAlignment="Justified"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Nous acceptons que l'autorité contractante ne soit pas tenue "
                    + "d'accepter l'offre la moins-disante ni aucune des offres reçues."]]></textFieldExpression>
            </textField>

            <!-- Lieu, date, signature -->
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="376" width="235" height="16"/>
                <textElement textAlignment="Left"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Fait à " + $P{LIEU} + ", le " + $P{DATE_LETTRES}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="280" y="398" width="235" height="14"/>
                <textElement textAlignment="Left"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SIGNATAIRE_NOM}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="280" y="412" width="235" height="14"/>
                <textElement textAlignment="Left"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SIGNATAIRE_FONCTION}]]></textFieldExpression>
            </textField>

            <!-- Emplacement du timbre fiscal, exige par le DAO -->
            <rectangle>
                <reportElement x="0" y="376" width="110" height="60" forecolor="#999999"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineStyle="Dashed"/>
                </graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="398" width="110" height="20"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{TIMBRE_FISCAL} == null || $P{TIMBRE_FISCAL}.isBlank()
                    ? "Timbre fiscal" : "Timbre fiscal\n" + $P{TIMBRE_FISCAL}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="515" height="1" forecolor="#AAAAAA"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="4" width="430" height="30"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[
                    $P{ENTREPRISE_RAISON_SOCIALE}
                    + ($P{ENTREPRISE_RCCM} == null || $P{ENTREPRISE_RCCM}.isBlank() ? "" : " · RCCM " + $P{ENTREPRISE_RCCM})
                    + ($P{ENTREPRISE_CC} == null || $P{ENTREPRISE_CC}.isBlank() ? "" : " · CC " + $P{ENTREPRISE_CC})
                    + ($P{ENTREPRISE_BP} == null || $P{ENTREPRISE_BP}.isBlank() ? "" : " · " + $P{ENTREPRISE_BP})
                    + ($P{ENTREPRISE_TELEPHONES} == null || $P{ENTREPRISE_TELEPHONES}.isBlank() ? "" : " · " + $P{ENTREPRISE_TELEPHONES})
                ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="4" width="75" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
