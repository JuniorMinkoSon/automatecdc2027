<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modele commun a toutes les lettres types de l'offre technique : engagement de
  delai, validite de l'offre, validite de la garantie, pouvoirs du signataire,
  conflit d'interets, declaration sur l'honneur.

  Un seul modele plutot que six quasi identiques : ce qui change d'une piece a
  l'autre, c'est le titre et le corps. Les corriger a un seul endroit evite que
  l'en-tete derive d'une piece a l'autre, ce qui est exactement ce qui est
  arrive dans les offres deposees a la main.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="lettre_type"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <parameter name="ENTREPRISE_RAISON_SOCIALE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_SIGLE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_RCCM" class="java.lang.String"/>
    <parameter name="ENTREPRISE_CC" class="java.lang.String"/>
    <parameter name="ENTREPRISE_BP" class="java.lang.String"/>
    <parameter name="ENTREPRISE_TELEPHONES" class="java.lang.String"/>

    <parameter name="AO_NUMERO" class="java.lang.String"/>
    <parameter name="AO_INTITULE" class="java.lang.String"/>
    <parameter name="AO_AUTORITE" class="java.lang.String"/>
    <parameter name="LOT_LIBELLE" class="java.lang.String"/>

    <parameter name="TITRE" class="java.lang.String"/>
    <parameter name="CORPS" class="java.lang.String"/>

    <parameter name="LIEU" class="java.lang.String"/>
    <parameter name="DATE_LETTRES" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_NOM" class="java.lang.String"/>
    <parameter name="SIGNATAIRE_FONCTION" class="java.lang.String"/>

    <title>
        <band height="96">
            <staticText>
                <reportElement x="0" y="0" width="515" height="16"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[RÉPUBLIQUE DE CÔTE D'IVOIRE]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="16" width="515" height="12"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[Union - Discipline - Travail]]></text>
            </staticText>
            <line>
                <reportElement x="180" y="34" width="155" height="1"/>
            </line>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="48" width="515" height="20"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TITRE} == null ? "" : $P{TITRE}.toUpperCase()]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="74" width="515" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{LOT_LIBELLE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="480">
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="0" width="515" height="40"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Objet : " + $P{AO_INTITULE}
                    + ($P{AO_NUMERO} == null || $P{AO_NUMERO}.isBlank()
                       ? "" : "\nAppel d'offres n° " + $P{AO_NUMERO})]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="56" width="515" height="300"/>
                <textElement textAlignment="Justified"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{CORPS}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="280" y="380" width="235" height="16"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Fait à " + $P{LIEU} + ", le " + $P{DATE_LETTRES}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="430" width="235" height="14"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SIGNATAIRE_NOM}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="280" y="444" width="235" height="14"/>
                <textElement><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{SIGNATAIRE_FONCTION}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="26">
            <line>
                <reportElement x="0" y="0" width="515" height="1" forecolor="#AAAAAA"/>
            </line>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="4" width="430" height="18"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[
                    $P{ENTREPRISE_RAISON_SOCIALE}
                    + ($P{ENTREPRISE_RCCM} == null || $P{ENTREPRISE_RCCM}.isBlank() ? "" : " · RCCM " + $P{ENTREPRISE_RCCM})
                    + ($P{ENTREPRISE_CC} == null || $P{ENTREPRISE_CC}.isBlank() ? "" : " · CC " + $P{ENTREPRISE_CC})
                    + ($P{ENTREPRISE_BP} == null || $P{ENTREPRISE_BP}.isBlank() ? "" : " · " + $P{ENTREPRISE_BP})
                    + ($P{ENTREPRISE_TELEPHONES} == null || $P{ENTREPRISE_TELEPHONES}.isBlank() ? "" : " · " + $P{ENTREPRISE_TELEPHONES})
                ]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="4" width="75" height="12"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
