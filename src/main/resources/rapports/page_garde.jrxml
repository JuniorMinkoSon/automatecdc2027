<?xml version="1.0" encoding="UTF-8"?>
<!--
  Page de garde du dossier. Premier endroit ou l'intitule du marche apparait,
  et le seul : les huit autres pieces le reprennent depuis la meme base.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="page_garde"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <parameter name="ENTREPRISE_RAISON_SOCIALE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_SIGLE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_RCCM" class="java.lang.String"/>
    <parameter name="ENTREPRISE_CC" class="java.lang.String"/>
    <parameter name="ENTREPRISE_ADRESSE" class="java.lang.String"/>
    <parameter name="ENTREPRISE_BP" class="java.lang.String"/>
    <parameter name="ENTREPRISE_TELEPHONES" class="java.lang.String"/>

    <parameter name="TYPE_OFFRE" class="java.lang.String"/>
    <parameter name="AO_NUMERO" class="java.lang.String"/>
    <parameter name="AO_INTITULE" class="java.lang.String"/>
    <parameter name="AO_AUTORITE" class="java.lang.String"/>
    <parameter name="LOT_LIBELLE" class="java.lang.String"/>
    <parameter name="DATE_LETTRES" class="java.lang.String"/>

    <title>
        <band height="700">
            <staticText>
                <reportElement x="0" y="0" width="515" height="18"/>
                <textElement textAlignment="Center"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[RÉPUBLIQUE DE CÔTE D'IVOIRE]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="18" width="515" height="12"/>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <text><![CDATA[Union - Discipline - Travail]]></text>
            </staticText>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="0" y="70" width="515" height="30"/>
                <textElement textAlignment="Center"><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{AO_AUTORITE}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="150" y="130" width="215" height="1"/>
            </line>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="180" width="455" height="60"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TYPE_OFFRE}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="270" width="455" height="70"/>
                <textElement textAlignment="Center"><font size="12"/></textElement>
                <textFieldExpression><![CDATA[$P{AO_INTITULE}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="30" y="350" width="455" height="18"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{LOT_LIBELLE}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="30" y="374" width="455" height="16"/>
                <textElement textAlignment="Center"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{AO_NUMERO} == null || $P{AO_NUMERO}.isBlank()
                    ? "" : "Appel d'offres n° " + $P{AO_NUMERO}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="150" y="440" width="215" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="470" width="515" height="14"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <text><![CDATA[Soumissionnaire]]></text>
            </staticText>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="490" width="455" height="24"/>
                <textElement textAlignment="Center"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{ENTREPRISE_RAISON_SOCIALE}
                    + ($P{ENTREPRISE_SIGLE} == null || $P{ENTREPRISE_SIGLE}.isBlank()
                       ? "" : " (" + $P{ENTREPRISE_SIGLE} + ")")]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="520" width="455" height="48"/>
                <textElement textAlignment="Center"><font size="9"/></textElement>
                <textFieldExpression><![CDATA[
                    ($P{ENTREPRISE_ADRESSE} == null || $P{ENTREPRISE_ADRESSE}.isBlank() ? "" : $P{ENTREPRISE_ADRESSE} + "\n")
                    + ($P{ENTREPRISE_BP} == null || $P{ENTREPRISE_BP}.isBlank() ? "" : $P{ENTREPRISE_BP} + "\n")
                    + ($P{ENTREPRISE_TELEPHONES} == null || $P{ENTREPRISE_TELEPHONES}.isBlank() ? "" : $P{ENTREPRISE_TELEPHONES} + "\n")
                    + ($P{ENTREPRISE_RCCM} == null || $P{ENTREPRISE_RCCM}.isBlank() ? "" : "RCCM " + $P{ENTREPRISE_RCCM})
                    + ($P{ENTREPRISE_CC} == null || $P{ENTREPRISE_CC}.isBlank() ? "" : " · CC " + $P{ENTREPRISE_CC})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="30" y="620" width="455" height="16"/>
                <textElement textAlignment="Center"><font size="9" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{DATE_LETTRES}]]></textFieldExpression>
            </textField>
        </band>
    </title>
</jasperReport>
