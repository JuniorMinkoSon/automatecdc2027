<?xml version="1.0" encoding="UTF-8"?>
<!--
  Recu de paiement d'un abonnement a la plateforme.

  Le montant y figure en chiffres et en lettres, comme sur toute piece
  comptable, et les deux sortent du meme entier. La reference du paiement est
  celle de l'agregateur : c'est elle qui permet de rapprocher le recu de la
  transaction, et c'est pour cela qu'elle est unique en base.

  Un recu n'est emis que pour un paiement confirme. Aucune transaction n'est
  presentee comme reussie sans confirmation verifiable du fournisseur.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="recu_paiement"
              pageWidth="595" pageHeight="842"
              columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">

    <parameter name="PLATEFORME" class="java.lang.String"/>
    <parameter name="NUMERO_RECU" class="java.lang.String"/>
    <parameter name="CLIENT" class="java.lang.String"/>
    <parameter name="CLIENT_RCCM" class="java.lang.String"/>
    <parameter name="MONTANT_CHIFFRES" class="java.lang.String"/>
    <parameter name="MONTANT_LETTRES" class="java.lang.String"/>
    <parameter name="MOYEN" class="java.lang.String"/>
    <parameter name="REFERENCE" class="java.lang.String"/>
    <parameter name="OBJET" class="java.lang.String"/>
    <parameter name="PERIODE" class="java.lang.String"/>
    <parameter name="DATE_LETTRES" class="java.lang.String"/>

    <title>
        <band height="520">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="515" height="18"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{PLATEFORME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="60" width="515" height="24"/>
                <textElement textAlignment="Center"><font size="17" isBold="true"/></textElement>
                <text><![CDATA[REÇU DE PAIEMENT]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="88" width="515" height="16"/>
                <textElement textAlignment="Center"><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{NUMERO_RECU} == null || $P{NUMERO_RECU}.isBlank()
                    ? "" : "N° " + $P{NUMERO_RECU}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="150" y="118" width="215" height="1"/>
            </line>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="150" width="455" height="34"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA["Reçu de : " + $P{CLIENT}
                    + ($P{CLIENT_RCCM} == null || $P{CLIENT_RCCM}.isBlank()
                       ? "" : "\nRCCM : " + $P{CLIENT_RCCM})]]></textFieldExpression>
            </textField>

            <!-- Les deux ecritures du montant sortent du meme entier. -->
            <rectangle>
                <reportElement x="30" y="200" width="455" height="90" backcolor="#EFEFEF"
                               forecolor="#CCCCCC"/>
                <graphicElement><pen lineWidth="0.75"/></graphicElement>
            </rectangle>
            <textField isBlankWhenNull="true">
                <reportElement x="46" y="214" width="423" height="22"/>
                <textElement textAlignment="Center"><font size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{MONTANT_CHIFFRES}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="46" y="242" width="423" height="40"/>
                <textElement textAlignment="Center"><font size="10" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA[$P{MONTANT_LETTRES}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="310" width="455" height="90"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[
                    "Objet : " + ($P{OBJET} == null ? "Abonnement à la plateforme" : $P{OBJET})
                    + ($P{PERIODE} == null || $P{PERIODE}.isBlank() ? "" : "\nPériode : " + $P{PERIODE})
                    + "\nMoyen de paiement : " + ($P{MOYEN} == null ? "" : $P{MOYEN})
                    + "\nRéférence de la transaction : " + ($P{REFERENCE} == null ? "" : $P{REFERENCE})
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="280" y="420" width="205" height="16"/>
                <textElement textAlignment="Right"><font size="10"/></textElement>
                <textFieldExpression><![CDATA["Le " + $P{DATE_LETTRES}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true" isStretchWithOverflow="true">
                <reportElement x="30" y="470" width="455" height="30"/>
                <textElement textAlignment="Center"><font size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["Ce reçu atteste un paiement confirmé par le "
                    + "prestataire. Il est émis automatiquement et ne nécessite pas de signature."]]></textFieldExpression>
            </textField>
        </band>
    </title>
</jasperReport>
